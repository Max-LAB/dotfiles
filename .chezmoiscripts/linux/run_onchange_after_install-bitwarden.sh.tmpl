#!/bin/sh
set -eu

{{- if eq .chezmoi.os "linux" }}

if command -v bw >/dev/null 2>&1; then
  echo "Bitwarden CLI already installed"
  exit 0
fi

BW_VERSION="2026.1.0"
INSTALL_DIR="$HOME/.local/bin"

mkdir -p "$INSTALL_DIR"

curl -L \
  "https://github.com/bitwarden/clients/releases/download/cli-v${BW_VERSION}/bw-linux-${BW_VERSION}.zip" \
  -o /tmp/bw.zip

unzip -o /tmp/bw.zip -d /tmp
chmod +x /tmp/bw
mv /tmp/bw "$INSTALL_DIR/bw"

echo "Bitwarden CLI installed to $INSTALL_DIR/bw"

{{- end }}
